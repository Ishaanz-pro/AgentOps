# Copy to .env and fill in. Never commit .env.

# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Model used by the ADK agent
AGENTOPS_MODEL=gemini-2.5-flash

# Embedding provider: "gemini" (needs GOOGLE_API_KEY) or "local" (offline hashed embeddings, used in tests)
AGENTOPS_EMBEDDINGS=gemini

# Paths
AGENTOPS_DB_PATH=data/agentops.db
AGENTOPS_POLICY_DIR=data/policies
AGENTOPS_INDEX_DIR=data/index

# Tool execution timeout in seconds
AGENTOPS_TOOL_TIMEOUT=5

# Log level
AGENTOPS_LOG_LEVEL=INFO
